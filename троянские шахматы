              <div className="text-gray-500">{idx + 1}.</div>
              <div>{p[0]}</div>
              <div>{p[1]}</div>
            </React.Fragment>
          ))}
        </div>
      </div>
    );
  };

  const Controls = ({ vsBot = false }: { vsBot?: boolean }) => (
    <div className="flex flex-wrap items-center gap-2">
      <button
        className="px-3 py-2 rounded-xl bg-white border shadow-sm hover:bg-gray-100"
        onClick={() => {
          const g = new Chess();
          setGame(g);
          setFen(g.fen());
          setMoveHistory([]);
          setStatus("New game started.");
        }}
      >
        New game
      </button>
      <button
        className="px-3 py-2 rounded-xl bg-white border shadow-sm hover:bg-gray-100"
        onClick={() => {
          safeGameMutate((g) => g.undo());
        }}
      >
        Undo
      </button>
      <button
        className="px-3 py-2 rounded-xl bg-white border shadow-sm hover:bg-gray-100"
        onClick={() => setOrientation((o) => (o === "white" ? "black" : "white"))}
      >
        Flip board
      </button>
      <label className="px-3 py-2 rounded-xl bg-white border shadow-sm">
        Promotion
        <select
          value={promotionPiece}
          onChange={(e) => setPromotionPiece(e.target.value)}
          className="ml-2 bg-transparent outline-none"
        >
          <option value="q">Queen</option>
          <option value="r">Rook</option>
          <option value="b">Bishop</option>
          <option value="n">Knight</option>
        </select>
      </label>
      {vsBot && (
        <label className="px-3 py-2 rounded-xl bg-white border shadow-sm">
          Bot plays
          <select
            value={botSide}
            onChange={(e) => setBotSide(e.target.value as any)}
            className="ml-2 bg-transparent outline-none"
          >
            <option value="black">Black</option>
            <option value="white">White</option>
          </select>
        </label>
      )}
      <div className="ml-auto"><Pill>{status}</Pill>{vsBot && botThinking && <Pill>Bot thinking…</Pill>}</div>
    </div>
  );

  return (
    <div className="min-h-screen bg-gradient-to-b from-gray-50 to-white text-gray-900 antialiased p-4">
      <div className="max-w-6xl mx-auto">
        {/* Header */}
        <header className="flex flex-wrap items-center justify-between gap-3 mb-6">
          <div className="flex items-center gap-3">
            <div className="w-10 h-10 rounded-2xl bg-black text-white grid place-items-center text-xl">♞</div>
            <div>
              <h1 className="text-2xl font-bold">троянские шахматы</h1>
              <p className="text-sm text-gray-500">Free-to-play chess • Local play • Simple bot • Lichess puzzles</p>
            </div>
          </div>
          <div className="flex items-center gap-2">
            <TabButton id="play">Play (2 players)</TabButton>
            <TabButton id="bot">Play vs Bot</TabButton>
            <TabButton id="puzzles">Puzzles</TabButton>
          </div>
        </header>

        {/* Content */}
        {tab === "play" && (
