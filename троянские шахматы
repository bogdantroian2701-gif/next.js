                  boardOrientation={orientation as any}
                  onPieceDrop={onPlayerMoveVsBot}
                  animationDuration={150}
                  customBoardStyle={{ borderRadius: 16, boxShadow: "0 2px 12px rgba(0,0,0,0.06)" }}
                />
              </div>
              <p className="text-xs text-gray-500 mt-3">Bot plays greedy captures; otherwise random legal moves. For a stronger engine later, you can plug in Stockfish WASM.</p>
            </div>
            <div className="space-y-4">
              <div className="bg-white rounded-3xl p-4 border shadow-sm">
                <h2 className="font-semibold mb-2">Moves</h2>
                <MoveList />
              </div>
