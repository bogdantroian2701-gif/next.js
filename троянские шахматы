  const TabButton = ({ id, children }: { id: string; children: any }) => (
    <button
      onClick={() => setTab(id)}
      className={`px-4 py-2 rounded-2xl text-sm font-medium border transition shadow-sm mr-2 mb-2 ${
        tab === id ? "bg-black text-white" : "bg-white hover:bg-gray-100"
      }`}
    >
      {children}
    </button>
  );

  const Pill = ({ children }: { children: any }) => (
    <span className="inline-block px-2 py-1 rounded-xl text-xs bg-gray-100 border">{children}</span>
  );

  const MoveList = () => {
    const pairs: string[][] = [];
    for (let i = 0; i < moveHistory.length; i += 2) {
      pairs.push([moveHistory[i] ?? "", moveHistory[i + 1] ?? ""]);
    }
    return (
      <div className="h-64 overflow-auto p-3 bg-white rounded-2xl border shadow-sm text-sm">
        <div className="grid grid-cols-3 gap-2">
          {pairs.map((p, idx) => (
