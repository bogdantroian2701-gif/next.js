// (embedded from Lichess). Built as a single-file React component.
// ────────────────────────────────────────────────────────────────────────────────

export default function TrojanChess() {
  const [tab, setTab] = useState("play"); // play | bot | puzzles
  const [game, setGame] = useState(() => new Chess());
  const [orientation, setOrientation] = useState("white");
  const [fen, setFen] = useState("start");
  const [moveHistory, setMoveHistory] = useState<string[]>([]);
  const [status, setStatus] = useState("Welcome! Create or load a game.");
  const [botThinking, setBotThinking] = useState(false);
  const [botSide, setBotSide] = useState<"white" | "black">("black");
  const [promotionPiece, setPromotionPiece] = useState("q");

  // Reset game when switching tabs that involve gameplay
  useEffect(() => {
    if (tab === "play" || tab === "bot") {
      const g = new Chess();
      setGame(g);
      setFen(g.fen());
      setMoveHistory([]);
      setStatus("New game started.");
    }
  }, [tab]);

  // ── Helpers ──────────────────────────────────────────────────────────────────
  function calcStatus(g: any) {
    if (g.isCheckmate()) return "Checkmate! " + (g.turn() === "w" ? "Black" : "White") + " wins.";
    if (g.isDraw()) return "Draw.";
    if (g.isStalemate()) return "Stalemate.";
    if (g.isThreefoldRepetition()) return "Draw by repetition.";
    if (g.isInsufficientMaterial()) return "Draw by insufficient material.";
    return (g.turn() === "w" ? "White" : "Black") + (g.inCheck() ? " to move (in check)." : " to move.");
  }

  function safeGameMutate(modifier: (g: any) => void) {
    setGame((g: any) => {
      const newGame = new Chess(g.fen());
      modifier(newGame);
      setFen(newGame.fen());
      setMoveHistory(newGame.history());
      setStatus(calcStatus(newGame));
      return newGame;
    });
  }

  // ── Player vs Player (same device) move handler ──────────────────────────────
  function onDrop(sourceSquare: string, targetSquare: string, piece: string) {
    let move: any = null;
    safeGameMutate((g) => {
      move = g.move({ from: sourceSquare, to: targetSquare, promotion: promotionPiece });
    });
    return move !== null;
  }

  // ── Very simple BOT (greedy capture; otherwise random legal move) ────────────
  function chooseBotMove(g: any) {
    const moves = g.moves({ verbose: true });
    if (moves.length === 0) return null;

    // Greedy capture first
    const captureMoves = moves.filter((m: any) => m.flags.includes("c") || m.flags.includes("e"));

    const scorePiece = (p: string) => {
      const map: Record<string, number> = { p: 1, n: 3, b: 3, r: 5, q: 9, k: 0 };
      return map[p.toLowerCase()] ?? 0;
    };

    if (captureMoves.length) {
      captureMoves.sort((a: any, b: any) => (scorePiece((b.captured || "")[0]) - scorePiece((a.captured || "")[0])));
      return captureMoves[0];
    }

    // Otherwise random legal
    return moves[Math.floor(Math.random() * moves.length)];
  }

  async function onPlayerMoveVsBot(sourceSquare: string, targetSquare: string, piece: string) {
    let humanMoveOk = false;
    safeGameMutate((g) => {
      const move = g.move({ from: sourceSquare, to: targetSquare, promotion: promotionPiece });
      humanMoveOk = !!move;
    });

    if (!humanMoveOk) return false;

    // Trigger bot if game isn't over and it's the bot's turn
    setTimeout(() => {
      setBotThinking(true);
      setTimeout(() => {
        safeGameMutate((g) => {
          if (g.isGameOver()) return;
          if ((botSide === "white" && g.turn() !== "w") || (botSide === "black" && g.turn() !== "b")) return;
          const move = chooseBotMove(g);
          if (move) g.move(move);
        });
        setBotThinking(false);
      }, 200); // tiny delay for UX
    }, 50);

    return true;
  }

