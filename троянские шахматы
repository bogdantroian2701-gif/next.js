                  areArrowsAllowed={true}
                  boardOrientation={orientation as any}
                  onPieceDrop={onDrop}
                  animationDuration={150}
                  customBoardStyle={{ borderRadius: 16, boxShadow: "0 2px 12px rgba(0,0,0,0.06)" }}
