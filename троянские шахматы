                <h2 className="font-semibold mb-2">Moves</h2>
                <MoveList />
              </div>
              <div className="bg-white rounded-3xl p-4 border shadow-sm">
                <h2 className="font-semibold mb-2">FEN</h2>
                <div className="p-3 bg-gray-50 rounded-xl border text-sm break-all">{fen}</div>
              </div>
            </div>
          </section>
